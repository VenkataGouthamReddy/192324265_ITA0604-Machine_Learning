from sklearn.linear_model import LinearRegression

X = [
    [2018, 50000],
    [2019, 40000],
    [2020, 30000],
    [2021, 20000],
    [2022, 10000]
]

y = [
    500000,
    600000,
    700000,
    800000,
    900000
]

model = LinearRegression()

model.fit(X, y)

print("Predicted Price:",
      model.predict([[2023, 5000]])[0])
