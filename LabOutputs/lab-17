from sklearn.tree import DecisionTreeClassifier

# RAM, Storage
X = [
    [2, 16],
    [2, 32],
    [4, 64],
    [4, 128],
    [6, 128],
    [8, 256]
]

y = [
    'Low',
    'Low',
    'Medium',
    'Medium',
    'High',
    'Premium'
]

model = DecisionTreeClassifier()

model.fit(X, y)

print("Price Range:",
      model.predict([[8, 128]])[0])
