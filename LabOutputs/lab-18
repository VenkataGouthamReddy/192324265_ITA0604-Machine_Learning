from sklearn.datasets import load_iris
from sklearn.linear_model import Perceptron

iris = load_iris()

X = iris.data

# Setosa = 1, Other = 0
y = (iris.target == 0).astype(int)

model = Perceptron()

model.fit(X, y)

sample = [[5.1, 3.5, 1.4, 0.2]]

result = model.predict(sample)

if result[0] == 1:
    print("Setosa")
else:
    print("Not Setosa")
