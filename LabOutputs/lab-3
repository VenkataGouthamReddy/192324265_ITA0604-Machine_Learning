from sklearn.tree import DecisionTreeClassifier

X = [
    [1, 1],
    [1, 0],
    [0, 1],
    [0, 0],
    [1, 1],
    [0, 0]
]

y = ['Yes', 'Yes', 'No', 'No', 'Yes', 'No']

model = DecisionTreeClassifier(criterion='entropy')
model.fit(X, y)

sample = [[1, 1]]

print("Prediction:", model.predict(sample)[0])
